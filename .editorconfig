root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
binary_next_line = true
switch_case_indent = true
space_redirects = true

[Dockerfile]
indent_style = space

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
